[Unit]
Description=handout — share agent-generated files
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/handout serve
EnvironmentFile=/etc/handout.env
DynamicUser=yes
StateDirectory=handout
Environment=HANDOUT_DATA_DIR=/var/lib/handout
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
